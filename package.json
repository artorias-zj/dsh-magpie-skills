{
  "name": "dsh-magpie-skills",
  "version": "1.0.0",
  "description": "DSH 插件：把 magpie 技能库（magpie panel 里安装/启用的 skills）注册进 DSH 的技能注册表，使它们在会话里可以直接用 / 调用、模型侧也能用 skill 工具加载。Bridges the magpie skill library shipped with dsh-our-free-model into DeepSeek Harness's skill registry so magpie skills appear in the / menu.",
  "license": "MIT",
  "author": "artorias-zj",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artorias-zj/dsh-magpie-skills.git"
  },
  "homepage": "https://github.com/artorias-zj/dsh-magpie-skills#readme",
  "bugs": {
    "url": "https://github.com/artorias-zj/dsh-magpie-skills/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "skill",
    "skills",
    "magpie",
    "our-free-model"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.15.0 || >=24.0.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
